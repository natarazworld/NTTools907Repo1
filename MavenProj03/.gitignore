# ================================
# Java / Maven / Eclipse .gitignore
# ================================

# -------- Maven --------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml

# -------- Java compiled files --------
*.class
*.jar
*.war
*.ear

# -------- Eclipse IDE --------
.classpath
.project
.settings/
.factorypath

# Eclipse JDT
.apt_generated/
.springBeans
.sts4-cache/

# Eclipse metadata
.metadata/

# -------- IntelliJ IDEA (optional) --------
.idea/
*.iml
*.iws
*.ipr
out/

# -------- NetBeans (optional) --------
/nbproject/private/
/nbbuild/
/dist/
/.nb-gradle/

# -------- VS Code (optional) --------
.vscode/

# -------- Logs --------
*.log
logs/

# -------- OS generated files --------
.DS_Store
Thumbs.db
desktop.ini

# -------- Temporary / backup files --------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# -------- Java crash logs --------
hs_err_pid*
replay_pid*

# -------- Environment / secrets --------
.env
.env.*
!.env.example

# -------- Generated files --------
generated/
generated-sources/
generated-test-sources/

# -------- Test reports --------
surefire-reports/
failsafe-reports/

# -------- Coverage reports --------
jacoco.exec
jacoco-report/